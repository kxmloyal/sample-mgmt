# 制造品质管理系统 - 环境变量配置示例
# 用法：复制本文件为 .env，按需修改后重启服务
#   cp .env.example .env
# 注意：.env 文件不应提交到 git，已在 .gitignore 中忽略

# 服务监听端口（默认 3000）
PORT=3000

# 会话签名密钥（生产环境务必改为随机长串）
# 生成方式：openssl rand -hex 32
SESSION_SECRET=sample-mgmt-dev-secret-change-me

# 环境标识：development / production
NODE_ENV=development

# 速率限制（生产可调）
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=200

# 日志目录
LOG_DIR=logs

# 上传文件大小限制（字节，默认 5MB）
UPLOAD_MAX_SIZE=5242880

# MariaDB 数据库连接（必填，迁移 SQLite 后启用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sample_mgmt
DB_PASSWORD=your-db-password-here
DB_NAME=sample_mgmt
