    "express": "4.21.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "7.4.0",
    "express-session": "1.18.0",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "qrcode": "1.5.4",
    "uuid": "^14.0.1",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "prettier": "3.3.0",
    "supertest": "7.0.0"
