    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\""
  },
  "dependencies": {
    "@fluentui/web-components": "^2.6.1",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.1",
