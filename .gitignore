node_modules/
# data/ 上传产物目录整体忽略，仅放行管制流程单一事实来源 control-flow.json（git 不进入被忽略目录，须用 /* 形式）
data/*
public/uploads/
*.log
.DS_Store

# 环境变量配置（包含敏感信息，禁止提交）
.env
.env.local
.env.production
logs/
.superpowers/

# curl cookie 文件
cj.txt

# 临时文档/二进制文件（不应提交到仓库根目录）
*.doc
*.docx

# 备份文件
*.bak.demo
*.bak.p1
*.bak.*

# 临时目录（测试日志/审计文件）
tmp/

# 前端 bundle 构建产物版本号（每次构建自动生成，无版本控制价值）
tools/.bundle-ver

# 管制流程单一事实来源（流程 JSON 由工具构建时注入前端，必须版本管理）
!/data/control-flow.json
